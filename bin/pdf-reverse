#!/bin/bash
# Reverses the page order of the input .pdf

usage() {
  echo "Usage: ${0##*/} [input.pdf] >output.pdf   (reads stdin if no input given)"
  echo "Reverses the page order, so the last page of the input comes out first"
}

die() {
  usage >&2
  exit 1
}

require() {
  command -v "$1" >/dev/null && return
  echo "${0##*/}: $1 is not installed, installing it now..." >&2
  (set -x; sudo apt-get install -y "$2") >&2 || exit 1
  command -v "$1" >/dev/null || { echo "${0##*/}: $1 still not available" >&2; exit 1; }
}

if [[ $1 == -h || $1 == --help ]]; then
  usage
  exit 0
fi

if [[ $# -gt 1 ]]; then
  die
elif [[ $# -eq 1 ]]; then
  [[ -f $1 && -r $1 ]] || { echo "${0##*/}: cannot read $1" >&2; exit 1; }
  INPUT=$(realpath -- "$1")
elif [[ ! -t 0 ]]; then
  INPUT=-
else
  die
fi

if [[ -t 1 ]]; then
  die
fi

require pdftk pdftk-java

set -e -o pipefail
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
cd "$TMP"
if [[ $INPUT == - ]]; then
  cat >input.pdf
else
  cp -- "$INPUT" input.pdf
fi

set -x
pdftk input.pdf burst output pg_%04d.pdf
mapfile -t PAGES < <(ls pg_????.pdf | tac)
pdftk "${PAGES[@]}" cat output output.pdf
set +x

cat output.pdf

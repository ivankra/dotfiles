# shellcheck shell=bash
# Bash history:
# * keep deduped in ~/.history/bash.YYYYMM files
# * load last few months on startup
# * append to last history file but don't read back
# * force to re-read history: h
#
# Turning history off: unset HISTFILE or make ~/.history a regular file.

# Re-read history (if on) to synchronize with other shell instances.
# Also fix various terminal issues.
h() {
  if [[ -n "$HISTFILE" ]]; then
    __bashrc_erasedups
  fi
  hash -r
  declare -F __reset_colorfgbg >/dev/null && __reset_colorfgbg
  declare -F __bashrc_fix_tty >/dev/null && __bashrc_fix_tty
}

# Dedup the last 12 months' files and load them, oldest first, the current
# month's as HISTFILE. With $1 = startup, bash loads HISTFILE itself after
# bashrc, so not here; else (h) flush and reload all. Any python works, also
# 2.x on old systems; without one: no dedup, only the current month.
__bashrc_erasedups() {
  if [[ "$1" != startup ]]; then
    history -a
    history -c
  fi

  local py f files=()
  for py in python3 python ''; do
    hash "$py" 2>/dev/null && break
  done
  if [[ -n "$py" ]]; then
    while IFS= read -r f; do  # one per line: paths may have spaces
      files+=("$f")
    done < <("$py" ~/.dotfiles/bin/erasedups.py --expand=12 "$HOME/.history/bash.%Y%m")
  fi
  if (( ${#files[@]} == 0 )); then
    files=("$HOME/.history/bash.$(date +%Y%m)")
  fi

  for f in "${files[@]}"; do
    HISTFILE=$f
    if [[ "$1" != startup || "$f" != "${files[${#files[@]}-1]}" ]]; then
      history -r "$f"
    fi
  done
}

# Append new history lines to HISTFILE, if history is on.
# Called from PS0 and PROMPT_COMMAND before and after a command runs.
__bashrc_history_append() {
  if [[ -n "$HISTFILE" ]]; then
    history -a
  fi
}

shopt -s cmdhist histverify histreedit

HISTCONTROL=ignoreboth
HISTSIZE=100000

# No ~/.history and can't create it (e.g. a file there): history disabled
if [[ ! -d ~/.history ]] && ! mkdir -m 0700 ~/.history 2>/dev/null; then
  HISTFILE=
  return
fi

shopt -s histappend
HISTFILESIZE=-1
HISTIGNORE='bg:fg:clear:ls:pwd:history:exit'
HISTTIMEFORMAT='[%F %T] '

# Once per shell: re-sourcing bashrc keeps the loaded history and HISTFILE
if [[ -z "$__bashrc_history_loaded" ]]; then
  __bashrc_history_loaded=1
  __bashrc_erasedups startup
fi

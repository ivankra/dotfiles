" Load vim's defaults.vim, which it skips once a vimrc exists
silent! source $VIMRUNTIME/defaults.vim

set autoread                            " Automatically re-read files changed outside of vim
set belloff=all                         " No beeps or flashes
set confirm                             " Confirm to save when closing a modified buffer instead of error
set encoding=utf-8                      " Use utf-8 to represent text internally in vim
set fileencodings=ucs-bom,utf-8,cp1251  " List of encodings to check when opening an existing file
set foldmethod=marker                   " Folds are defined by triple curly brace markers
set formatoptions+=r                    " Automatically continue comments after pressing <Enter>
set formatoptions+=j                    " Remove comment leaders when joining lines (J)
set gdefault                            " Replace does /g by default
set hidden                              " Switch away from modified buffers without saving first
set hlsearch                            " Highlight all matches
set ignorecase                          " Case-insensitive search by default (add \C to pattern to override)
set laststatus=2                        " Always show statusline
set mouse=                              " No mouse in terminal Vim (defaults.vim sets mouse=a)
set noswapfile viminfo=""               " Don't create any kind of temporary files
set pumheight=10                        " Limit popup menu's height
set sidescroll=1                        " Scroll horizontally by one column (nowrap), not half a screen
set smartcase                           " Case-sensitive search if pattern contains uppercase characters
set splitbelow                          " Put new split window below
set splitright                          " Put new vertically split window to the right
set timeoutlen=300                      " Wait 300ms for mapped sequences, e.g. ui.vim's <Esc>z (Alt+Z), as in nvim
set ttimeoutlen=50                      " Wait 50ms (defaults.vim: 100), not 'timeoutlen', for key codes: no Esc lag
set virtualedit=block                   " Allow cursor to move beyond end-of-line in block selection mode
set wildmode=longest:full,full          " Completion mode like readline
silent! set wildoptions=pum             " Show a popup menu for autocompletions (8.2.4325+, e.g. not Ubuntu 22.04)

" Default indent options. Will get adjusted by vim-sleuth.
set autoindent                          " Basic autoindent
set expandtab                           " Expand tabs
set softtabstop=-1                      " Use shiftwidth value
set shiftwidth=2                        " 2 space indent

" Wrapping
set nowrap                              " No line wrapping by default
set linebreak                           " Wrap line at whitespace
set breakindent                         " Continue original indentation on wrapped lines
set breakindentopt=shift:2,sbr          " At least 2 column indent and enable showbreak
set showbreak=↪\                        " Wrapping indicator e.g. ↪ ⤷ ↳ └─▶ (no quotes: " starts a comment)

set statusline=
set statusline+=%<%f                    " File path
set statusline+=%h                      " Help flag [help]
set statusline+=%m                      " Modified flag [+]
set statusline+=%r                      " Readonly flag [RO]
set statusline+=%=                      " === Right side ===
set statusline+=\ 0x%02B                " Hex value of char under cursor
set statusline+=\ \ %{&fenc!=''?&fenc:&enc} " File encoding: utf-8
set statusline+=\ \ %y                  " FileType: [python]
set statusline+=\ %3l:%-2c              " line:col
set statusline+=\ %P                    " Percentage through file

" 24-bit color in terminals that announce it (kitty, Ghostty, WezTerm, ...) or,
" e.g. over ssh where $COLORTERM is dropped, look like xterm/tmux; not in the
" Linux console
if has("termguicolors") && ($COLORTERM =~# '^\%(truecolor\|24bit\)$' || $TERM =~# '^\%(xterm\|screen\|tmux\)-256color$')
  set termguicolors
endif

" Yank/paste via the system clipboard: "+" on X11/Wayland.
" macOS has one "*" and yanks into it only with "unnamed".
if has("mac")
  set clipboard=unnamed
else
  set clipboard=unnamedplus
endif

" Clipboard fallback after X11/Wayland (e.g. SSH): copy-only OSC 52.
" Forced: few terminals announce it. No paste: often unsupported/behind prompt.
if has("eval") && exists("+clipmethod") && exists("v:clipproviders")
  let g:osc52_force_avail = 1
  let g:osc52_disable_paste = 1
  silent! packadd osc52
  if has_key(v:clipproviders, "osc52")
    set clipmethod+=osc52
  endif
endif

" Optional packages bundled with Vim 9.1+, for what nvim has built in.
" silent!: older Vims don't have them.
if has("eval")
  silent! packadd! comment       " gc{motion}, gcc: toggle comments. Ctrl+/ in plugin/comment.vim
  silent! packadd! editorconfig  " Apply .editorconfig (vim-sleuth reads its indent settings too)
  silent! packadd! hlyank        " Highlight yanked text briefly
  silent! packadd! matchit       " Extend % to if/else/endif etc
  silent! packadd! nohlsearch    " Clear search highlight after 'updatetime' idle or in Insert mode
endif

if has("eval")
  let mapleader = " "                   " <leader> key

  let g:is_bash = 1
  let g:markdown_minlines = 1000
  let g:netrw_dirhistmax = 0
  let g:tex_flavor = "latex"
  let g:pyindent_open_paren = "&sw"
end

" [ cd]: cd to current file's directory (alternative: set autochdir)
nnoremap <leader>cd :cd %:p:h<CR>
" Visual: <C-U> drops the '<,'> range :cd can't take
xnoremap <leader>cd :<C-U>cd %:p:h<CR>gv

" Typing %%/ in command mode expands to current file's directory. Only on the
" : line, not in / searches. fnameescape(): a dir like notes#1 would otherwise
" expand # to the alternate file.
cabbr <expr> %% getcmdtype() == ':' ? fnameescape(expand('%:p:h')) : '%%'

" Ctrl-L also clears search highlight and updates diffs, as in nvim
nnoremap <silent> <C-L> :nohls<Bar>diffupdate<CR><C-L>
xnoremap <silent> <C-L> :<C-U>nohls<Bar>diffupdate<CR>gv<C-L>

if has("syntax")
  syntax on
endif

if has("autocmd")
  filetype plugin indent on

  " In a group cleared first, so re-sourcing vimrc doesn't add them again
  augroup vimrc
    autocmd!
    " Not javascript: its indent script sets 'indentexpr', which wins over
    " 'cindent'. Java's also does, but calls cindent(), which uses 'cino'.
    autocmd FileType c,cpp,java             setlocal cin cino=j1,+2s,g1,h1,(0,l1
    autocmd FileType make                   setlocal noet

    " Load large files faster: disable syntax/folding. BufReadPost, after
    " filetype detection (filetypedetect is defined earlier), which would
    " otherwise set 'syntax' again.
    autocmd BufReadPost * if getfsize(expand("<afile>")) > 10485760 | setlocal syntax=OFF fdm=manual | endif
  augroup END
endif

if has("gui_running")
  set guioptions-=T   " disable toolbar
  set guioptions-=t   " disable tear-off menu items
  set guioptions+=d   " use dark theme variant
  set mouse=a

  if exists("+lines") && exists("+columns")
    set lines=45
    set columns=120
  endif

  " Use system monospace font
  if filereadable("/usr/bin/dconf")
    let dconffont = system("dconf read /org/gnome/desktop/interface/monospace-font-name | tr -d \"'\" | tr -d \\\\n")
    if len(dconffont) > 1
      let &guifont = dconffont
    endif
  endif
endif
